{
  "$schema": "https://biomejs.dev/schemas/2.4.16/schema.json",
  "formatter": {
    "enabled": true,
    "formatWithErrors": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100
  },
  "linter": {
    "enabled": false
  },
  "files": {
    "includes": [
      "src/**",
      "scripts/**",
      "**/*.ts",
      "**/*.svelte",
      "**/*.json",
      "**/*.md",
      "**/*.js",
      "!dist/**",
      "!logseq-environments/**",
      "!tests/styles/style.css",
      "!tests/logseq-sim-lib.js",
      "!tests/logseq-mock-api.js"
    ],
    "ignoreUnknown": true,
    "maxSize": 2097152
  },
  "assist": {
    "actions": {
      "source": {
        "organizeImports": "on"
      }
    }
  }
}
