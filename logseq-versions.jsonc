{
  // JSONC config for Logseq binary resolution.
  // Supported source modes: release (default), workflow, local.
  "legacy": {
    // File-based Logseq release tag.
    "tag": "0.10.15"
  },
  "db": {
    // User-provided beta binary directory.
    "source": "local",
    // Relative to this config file.
    "directory": "logseq-environments/app/db/beta",
    // Useful for macOS app bundles or nonstandard layouts.
    "binaryRelativePathOverrides": {
      "darwin-x64": "Logseq.app/Contents/MacOS/Logseq",
      "darwin-arm64": "Logseq.app/Contents/MacOS/Logseq"
    }
  }
}
