{
  "name": "logseq-doc-agent",
  "private": true,
  "version": "0.1.4",
  "type": "module",
  "main": "index.html",
  "scripts": {
    "dev": "concurrently \"vite build --watch\" \"http-server -c-1 -p 9000 .\"",
    "build": "vite build",
    "preview": "vite preview",
    "check": "svelte-check --tsconfig ./tsconfig.app.json && tsc -p tsconfig.node.json",
    "lint": "oxlint --fix .",
    "lint:check": "oxlint .",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "review": "tsx scripts/review.ts",
    "review:quick": "tsx scripts/review.ts --quick",
    "spell": "cspell --no-progress \"**\"",
    "deadcode": "ts-prune",
    "circulardeps": "madge --circular --extensions ts,svelte src/",
    "coverage": "vitest run --coverage",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "test:run": "vitest run",
    "test:arch": "vitest run tests/architecture/architecture.test.ts",
    "test:arch:reports": "vitest run tests/architecture/architecture-reports.test.ts",
    "release": "changeset version && git add . && git commit -m \"chore: release v$(node -p \"require('./package.json').version\")\" && git tag v$(node -p \"require('./package.json').version\") && git push origin master --tags",
    "test:e2e": "playwright test",
    "test:e2e:debug": "PWDEBUG=1 playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:auto": "tsx scripts/run-e2e.ts legacy",
    "test:e2e:legacy": "tsx scripts/run-e2e.ts legacy",
    "test:e2e:db": "tsx scripts/run-e2e.ts db",
    "test:mcp": "npx @playwright/mcp@latest",
    "start:mcp:legacy": "tsx scripts/mcp-logseq.ts legacy",
    "start:mcp:db": "tsx scripts/mcp-logseq.ts db",
    "start:mcp:init:legacy": "tsx scripts/run-logseq.ts legacy --mcp",
    "start:mcp:init:db": "tsx scripts/run-logseq.ts db --mcp",
    "start:e2e:init:legacy": "tsx scripts/run-logseq.ts legacy --e2e",
    "start:e2e:init:db": "tsx scripts/run-logseq.ts db --e2e",
    "start:legacy": "tsx scripts/run-logseq.ts legacy",
    "start:db": "tsx scripts/run-logseq.ts db"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.16",
    "@changesets/cli": "^2.30.0",
    "@playwright/mcp": "^0.0.68",
    "@playwright/test": "^1.58.2",
    "@sveltejs/vite-plugin-svelte": "6.2.4",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/svelte": "^5.3.1",
    "@tsconfig/svelte": "^5.0.6",
    "@types/node": "^24.10.1",
    "@types/textarea-caret": "^3.0.4",
    "@vitest/coverage-v8": "^4.1.8",
    "archunit": "^2.3.0",
    "concurrently": "^9.2.1",
    "cspell": "^10.0.1",
    "extract-zip": "^2.0.1",
    "http-server": "^14.1.1",
    "jsdom": "^27.4.0",
    "madge": "^8.0.0",
    "oxlint": "^1.68.0",
    "svelte": "5.56.2",
    "svelte-check": "^4.3.4",
    "ts-prune": "^0.10.3",
    "tsx": "^4.21.0",
    "typescript": "~5.9.3",
    "vite": "^7.2.4",
    "vitest": "^4.0.18"
  },
  "logseq": {
    "id": "logseq-doc-agent",
    "description": "An AI Agent for Logseq",
    "title": "Logseq Doc Agent",
    "icon": "icon.png",
    "author": "Stefan Kaufmann",
    "repo": "https://github.com/secondbrain-tools/logseq-doc-agent",
    "main": "dist/index.html"
  },
  "dependencies": {
    "@ai-sdk/amazon-bedrock": "^4.0.19",
    "@ai-sdk/anthropic": "^3.0.15",
    "@ai-sdk/azure": "^3.0.12",
    "@ai-sdk/google": "^3.0.10",
    "@ai-sdk/google-vertex": "^4.0.17",
    "@ai-sdk/mistral": "^3.0.9",
    "@ai-sdk/openai": "^3.0.12",
    "@ai-sdk/openai-compatible": "^2.0.35",
    "@logseq/libs": "^0.0.17",
    "@types/diff": "^7.0.2",
    "ai": "^6.0.39",
    "diff": "^8.0.3",
    "electron-playwright-mcp": "^1.0.1",
    "marked": "^17.0.1",
    "textarea-caret": "^3.1.0"
  },
  "overrides": {
    "dompurify": "3.4.8",
    "lodash-es": "4.18.1",
    "@modelcontextprotocol/sdk": "1.29.0"
  }
}
